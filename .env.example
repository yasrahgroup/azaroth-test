# Environment Variables for Azaroth Tech-Hive

# API Configuration (Frontend)
# VITE_API_BASE_URL must be set to the backend origin in production builds.
# If unset, the dev server fails visibly rather than silently falling back.
VITE_API_BASE_URL=
VITE_API_TIMEOUT=30000

# Analytics (optional, all opt-in)
VITE_GA_TRACKING_ID=
VITE_HOTJAR_ID=

# Feature Flags
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_HOTJAR=false