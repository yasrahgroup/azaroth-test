# Environment Variables for Azaroth Tech-Hive

# API Configuration
VITE_API_BASE_URL=https://api.azaroth-techhive.com
VITE_API_TIMEOUT=30000

# Neon Database Configuration
VITE_NEON_DATABASE_URL=postgresql://username:password@host/database
VITE_NEON_POOL_SIZE=10

# Contact Form Configuration
VITE_CONTACT_FORM_ENDPOINT=https://api.azaroth-techhive.com/contact
VITE_RFQ_ENDPOINT=https://api.azaroth-techhive.com/rfq

# Analytics
VITE_GA_TRACKING_ID=
VITE_HOTJAR_ID=

# Feature Flags
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_HOTJAR=false
